<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="KONZOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- %thread pokazuje u kojoj se niti poruka zapisala -->
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="hr.tecaj" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="KONZOLA"/>
    </root>
</configuration>
